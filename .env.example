# TAK Manager API — environment configuration
# Copy to .env for local development: cp .env.example .env
# Operational config (TAK URL, certs, enablements) lives in SQLite, not here.

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Where the SQLite DB, uploaded certs and data packages are stored.
# DATA_DIR=data

# Browser origins allowed to call the API cross-origin (JSON list).
# Not needed when the UI and /api share a host (the production setup).
# CORS_ORIGINS=["http://localhost:3000"]

# When true (default), trust Authentik forward-auth headers
# (x-authentik-username / x-authentik-groups); requests without them get 401.
# Set false for single-operator LAN deploys: every caller becomes admin.
# ONLY safe behind a firewall/VPN.
AUTH_ENABLED=false

# Fallback aisstream.io API key for AIS sources that don't set their own.
# Get a free key at https://aisstream.io
# AISSTREAM_API_KEY=
